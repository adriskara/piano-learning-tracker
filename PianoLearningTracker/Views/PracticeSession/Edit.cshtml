@model PianoLearningTracker.Models.PracticeSessionFormModel

@{
    ViewData["Title"] = "Uredi sesiju";
    var id = ViewContext.RouteData.Values["id"];
}

<ul class="breadcrumb-list">
    <li><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
    <li><a asp-controller="PracticeSession" asp-action="Index">Sesije vježbanja</a></li>
    <li><a asp-action="Details" asp-route-id="@id">Sesija #@id</a></li>
    <li>Uredi</li>
</ul>

<div class="form-card">
    <form asp-action="Edit" asp-route-id="@id" method="post" novalidate>
        @Html.AntiForgeryToken()

        <div class="form-grid-2">
            @if (!User.IsInRole("Student"))
            {
                @await Html.PartialAsync("_Autocomplete", new PianoLearningTracker.Models.AutocompleteDropdownModel
                {
                    FieldId = "StudentId",
                    FieldName = "StudentId",
                    DisplayFieldId = "StudentId_display",
                    DisplayName = "Učenik",
                    Endpoint = Url.Action("Autocomplete", "Student"),
                    SelectedId = Model.StudentId > 0 ? Model.StudentId : null,
                    SelectedText = Model.StudentName,
                    Required = true
                })
            }
            else
            {
                <input type="hidden" name="StudentId" value="@Model.StudentId" />
            }
            @await Html.PartialAsync("_Autocomplete", new PianoLearningTracker.Models.AutocompleteDropdownModel
            {
                FieldId = "PieceId",
                FieldName = "PieceId",
                DisplayFieldId = "PieceId_display",
                DisplayName = "Skladba",
                Endpoint = Url.Action("Autocomplete", "Piece"),
                SelectedId = Model.PieceId > 0 ? Model.PieceId : null,
                SelectedText = Model.PieceName,
                Required = true
            })
        </div>

        <div class="form-grid-2">
            @await Html.PartialAsync("_DateTimePicker", new PianoLearningTracker.Models.DateTimePickerModel
            {
                FieldId = "Date",
                FieldName = "Date",
                DisplayName = "Datum vježbanja",
                Value = Model.Date == default ? null : Model.Date,
                IncludeTime = false,
                Required = true
            })
            <div class="form-group">
                <label asp-for="DurationMinutes" class="form-label"></label>
                <input asp-for="DurationMinutes" class="form-control" type="number" min="1" max="480" />
                <span asp-validation-for="DurationMinutes" class="text-danger field-error"></span>
            </div>
        </div>

        <div class="form-grid-2">
            <div class="form-group">
                <label asp-for="QualityRating" class="form-label"></label>
                <select asp-for="QualityRating" class="form-control">
                    <option value="1">1 ★ — Loše</option>
                    <option value="2">2 ★★ — Osrednje</option>
                    <option value="3">3 ★★★ — Dobro</option>
                    <option value="4">4 ★★★★ — Vrlo dobro</option>
                    <option value="5">5 ★★★★★ — Odlično</option>
                </select>
                <span asp-validation-for="QualityRating" class="text-danger field-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Goals" class="form-label"></label>
            <textarea asp-for="Goals" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Goals" class="text-danger field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Notes" class="text-danger field-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Spremi promjene</button>
            <a asp-action="Details" asp-route-id="@id" class="btn btn-secondary">Odustani</a>
        </div>
    </form>
</div>
