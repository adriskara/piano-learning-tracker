@model IEnumerable<PianoLearningTracker.Models.PracticeSession>

@{
    ViewData["Title"] = "Sesije vježbanja";
}

<ul class="breadcrumb-list">
    <li><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
    <li>Sesije vježbanja</li>
</ul>

<div class="page-toolbar">
    <div class="search-bar">
        <span class="search-icon">🔍</span>
        <input type="text" id="search-input" class="search-input" placeholder="Pretraži sesije vježbanja..." autocomplete="off" />
    </div>
    @if (User.IsInRole("Administrator") || User.IsInRole("Student"))
    {
        <a class="btn btn-primary" asp-action="Create">+ Nova sesija</a>
    }
</div>

<div id="sessions-container">
    @await Html.PartialAsync("_PracticeSessionList", Model)
</div>

@section Scripts {
    <script>
        // AJAX pretraga sesija vježbanja
        var searchTimer;
        document.getElementById('search-input').addEventListener('input', function () {
            clearTimeout(searchTimer);
            var q = this.value;
            searchTimer = setTimeout(function () {
                fetch('/vjezbe/pretraga?q=' + encodeURIComponent(q), {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    document.getElementById('sessions-container').innerHTML = html;
                    animateCards();
                });
            }, 300);
        });

        animateCards();
    </script>
}
