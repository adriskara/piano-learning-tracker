@model IEnumerable<PianoLearningTracker.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<ul class="breadcrumb-list">
    <li>Dashboard</li>
    <li>Students</li>
</ul>

<div class="entity-grid">
    @foreach (var student in Model)
    {
        <article class="entity-card">
            <h2 class="entity-card-title">@student.FirstName @student.LastName</h2>
            <p class="entity-card-meta">Grade @student.Grade • Enrolled @student.EnrollmentDate:yyyy</p>
            <p class="entity-card-meta">Email: @student.Email</p>
            <div class="entity-card-actions">
                <a class="btn btn-primary btn-sm" asp-action="Details" asp-route-id="@student.Id">View details</a>
            </div>
        </article>
    }
</div>
