@model IEnumerable<PianoLearningTracker.Models.Student>

@if (!Model.Any())
{
    <div class="empty-state">
        <p>Nema pronađenih učenika.</p>
    </div>
}
else
{
    <div class="entity-grid">
        @foreach (var student in Model)
        {
            <article class="entity-card card-enter">
                <h2 class="entity-card-title">@student.FirstName @student.LastName</h2>
                <p class="entity-card-meta">Razred @student.Grade • Upisan @student.EnrollmentDate.Year</p>
                <p class="entity-card-meta">Email: @student.Email</p>
                @if (student.Teacher != null)
                {
                    <p class="entity-card-meta">Profesor: @student.Teacher.FirstName @student.Teacher.LastName</p>
                }
                <div class="entity-card-actions">
                    <a class="btn btn-primary btn-sm" asp-action="Details" asp-route-id="@student.Id">Detalji</a>
                    @if (User.IsInRole("Administrator"))
                    {
                        <a class="btn btn-secondary btn-sm" asp-action="Edit" asp-route-id="@student.Id">Uredi</a>
                        <form asp-action="Delete" asp-route-id="@student.Id" method="post" class="inline-form delete-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm"
                                    onclick="return confirm('Jeste li sigurni da želite obrisati učenika @student.FirstName @student.LastName?')">
                                Obriši
                            </button>
                        </form>
                    }
                </div>
            </article>
        }
    </div>
}
