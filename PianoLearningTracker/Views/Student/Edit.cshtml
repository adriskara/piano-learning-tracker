@model PianoLearningTracker.Models.StudentFormModel

@{
    ViewData["Title"] = "Uredi učenika";
    var id = ViewContext.RouteData.Values["id"];
}

<ul class="breadcrumb-list">
    <li><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
    <li><a asp-controller="Student" asp-action="Index">Učenici</a></li>
    <li><a asp-action="Details" asp-route-id="@id">@Model.FirstName @Model.LastName</a></li>
    <li>Uredi</li>
</ul>

<div class="form-card">
    <form asp-action="Edit" asp-route-id="@id" method="post" novalidate>
        @Html.AntiForgeryToken()

        <div class="form-grid-2">
            <div class="form-group">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger field-error"></span>
            </div>
        </div>

        <div class="form-grid-2">
            <div class="form-group">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger field-error"></span>
            </div>
        </div>

        <div class="form-grid-2">
            @* Datumska kontrola — partial view s flatpickr pluginom *@
            <partial name="_DateTimePicker" model='new PianoLearningTracker.Models.DateTimePickerModel {
                FieldId = "DateOfBirth", FieldName = "DateOfBirth",
                DisplayName = "Datum rođenja", Value = Model.DateOfBirth,
                IncludeTime = false, Required = true }' />
            <partial name="_DateTimePicker" model='new PianoLearningTracker.Models.DateTimePickerModel {
                FieldId = "EnrollmentDate", FieldName = "EnrollmentDate",
                DisplayName = "Datum upisa", Value = Model.EnrollmentDate,
                IncludeTime = false, Required = true }' />
        </div>

        <div class="form-grid-2">
            <div class="form-group">
                <label asp-for="Grade" class="form-label"></label>
                <input asp-for="Grade" class="form-control" type="number" min="1" max="6" />
                <span asp-validation-for="Grade" class="text-danger field-error"></span>
            </div>
            @* Autocomplete dropdown za odabir profesora — predefinirani odabir za edit *@
            <partial name="_Autocomplete" model='new PianoLearningTracker.Models.AutocompleteDropdownModel {
                FieldId = "TeacherId", FieldName = "TeacherId",
                DisplayFieldId = "TeacherDisplay", DisplayName = "Profesor",
                Endpoint = Url.Action("Autocomplete", "Teacher"),
                SelectedId = Model.TeacherId, SelectedText = Model.TeacherName,
                Required = false }' />
        </div>

        <div class="form-group">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Notes" class="text-danger field-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Spremi promjene</button>
            <a asp-action="Details" asp-route-id="@id" class="btn btn-secondary">Odustani</a>
        </div>
    </form>
</div>
