<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Piano Tracker</title>
    <style>
:root{--bg:#eef3fb;--surface:#fff;--surface-soft:#f8fbff;--text:#0f172a;--text-muted:#475569;--text-soft:#64748b;--accent:#2563eb;--accent-soft:rgba(37,99,235,.08);--accent-mid:#1d4ed8;--success:#16a34a;--success-soft:#dcfce7;--warning:#d97706;--warning-soft:#fef3c7;--gold:#b45309;--gold-soft:#fef9c3;--sidebar-bg:#111827;--sidebar-end:#212d47;--sidebar-muted:#cbd5e1;--border:rgba(148,163,184,.14);--shadow:0 16px 32px rgba(15,23,42,.06);--shadow-lg:0 18px 45px rgba(15,23,42,.08);--radius:1.75rem;--radius-sm:1.25rem;--radius-pill:999px;--transition:180ms ease;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color-scheme:light}
*{box-sizing:border-box;margin:0;padding:0}
html{min-height:100%;font-size:15px}
body{min-height:100vh;background:linear-gradient(180deg,var(--bg) 0%,#f8fbff 100%);color:var(--text)}
a{color:inherit;text-decoration:none}
button,input,select,textarea{font:inherit}
h1,h2,h3,h4{line-height:1.2}
.app-shell{display:grid;grid-template-columns:280px 1fr;min-height:100vh}
.app-sidebar{padding:2rem 1.5rem;background:linear-gradient(180deg,var(--sidebar-bg) 0%,var(--sidebar-end) 100%);color:#f8fafc;display:flex;flex-direction:column;gap:1.5rem;position:sticky;top:0;height:100vh;overflow-y:auto}
.brand-panel{display:flex;align-items:center;gap:.9rem;padding:.85rem 1rem;border-radius:1.5rem;background:rgba(255,255,255,.08);color:#fff}
.brand-mark{width:44px;height:44px;display:grid;place-items:center;border-radius:16px;background:rgba(168,199,255,.18);color:#dbeafe;font-size:1.4rem}
.brand-title{font-weight:700;font-size:1.05rem}
.brand-subtitle{font-size:.88rem;color:var(--sidebar-muted)}
.piano-separator{display:flex;gap:2px;padding:.25rem .5rem;opacity:.2;align-items:flex-start}
.piano-key{border-radius:0 0 3px 3px}
.piano-key.w{width:13px;height:22px;background:#fff}
.piano-key.b{width:9px;height:14px;background:#1e293b;margin:0 -4px;z-index:1;position:relative}
.sidebar-nav{display:grid;gap:.35rem}
.sidebar-link{display:flex;align-items:center;gap:.65rem;padding:.9rem 1rem;border-radius:var(--radius-sm);color:var(--sidebar-muted);font-size:.95rem;transition:transform var(--transition),background-color var(--transition),color var(--transition)}
.sidebar-link .nav-icon{font-size:1rem;opacity:.75}
.sidebar-link:hover,.sidebar-link.active{background:rgba(255,255,255,.08);color:#fff;transform:translateX(3px)}
.sidebar-link.active .nav-icon{opacity:1}
.sidebar-note{margin-top:auto;padding:.75rem 1rem .25rem;color:#94a3b8;font-size:.85rem;line-height:1.6}
.hamburger{display:none;position:fixed;top:1rem;left:1rem;z-index:200;background:var(--accent);color:#fff;border:none;border-radius:.75rem;width:44px;height:44px;font-size:1.2rem;cursor:pointer;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(37,99,235,.35)}
.app-main{padding:2rem 2.5rem;min-width:0}
.page-header{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1.75rem}
.page-header h1{font-size:clamp(1.8rem,2.5vw,2.6rem);font-weight:800;letter-spacing:-.04em}
.app-footer{margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border);display:flex;justify-content:space-between;color:var(--text-soft);font-size:.9rem}
.breadcrumb-list{display:flex;flex-wrap:wrap;gap:.4rem;margin:0 0 1.5rem;list-style:none;color:var(--text-muted);font-size:.88rem}
.breadcrumb-list li::after{content:"›";margin:0 .35rem;color:#cbd5e1}
.breadcrumb-list li:last-child::after{content:none}
.entity-grid{display:grid;gap:1.25rem;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
.entity-card{background:var(--surface);border-radius:var(--radius);box-shadow:var(--shadow-lg);border:1px solid var(--border);padding:1.4rem;transition:transform var(--transition),box-shadow var(--transition);position:relative;overflow:hidden}
.entity-card::after{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--accent),#818cf8);opacity:0;transition:opacity var(--transition)}
.entity-card:hover{transform:translateY(-3px);box-shadow:0 24px 48px rgba(15,23,42,.12)}
.entity-card:hover::after{opacity:1}
.entity-card-title{font-size:1.05rem;font-weight:700;margin-bottom:.6rem}
.entity-card-meta{color:var(--text-muted);font-size:.9rem;margin-bottom:.3rem}
.entity-card-actions{margin-top:1.25rem}
.status-badge{display:inline-flex;align-items:center;gap:.3rem;padding:.28rem .75rem;border-radius:var(--radius-pill);font-size:.78rem;font-weight:700}
.status-badge.completed{background:var(--success-soft);color:var(--success)}
.status-badge.scheduled{background:#dbeafe;color:#1d4ed8}
.status-badge.cancelled{background:#fee2e2;color:#dc2626}
.diff-badge{display:inline-flex;padding:.25rem .65rem;border-radius:var(--radius-pill);font-size:.75rem;font-weight:700}
.diff-badge.beginner{background:var(--success-soft);color:var(--success)}
.diff-badge.elementary{background:#dbeafe;color:#1d4ed8}
.diff-badge.intermediate{background:var(--warning-soft);color:var(--warning)}
.diff-badge.advanced{background:#fce7f3;color:#be185d}
.progress-block{margin-bottom:.2rem}
.progress-label{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:.3rem}
.progress-label span{font-size:.85rem;color:var(--text-muted)}
.progress-label strong{font-size:.88rem;color:var(--text)}
.progress-track{background:#e2e8f0;border-radius:var(--radius-pill);height:10px;overflow:hidden}
.progress-fill{height:100%;border-radius:var(--radius-pill);background:linear-gradient(90deg,var(--accent),#818cf8);transition:width .5s ease}
.progress-fill.done{background:linear-gradient(90deg,var(--success),#4ade80)}
.progress-fill.gold{background:linear-gradient(90deg,var(--gold),#fbbf24)}
.achievement-badge{display:inline-flex;align-items:center;gap:.35rem;padding:.3rem .75rem;border-radius:var(--radius-pill);background:var(--gold-soft);color:var(--gold);font-size:.8rem;font-weight:700;border:1px solid #fde68a}
.quality-stars{display:inline-flex;gap:1px;font-size:.9rem}
.star-on{color:#f59e0b}
.star-off{color:#e2e8f0}
.detail-panel{display:grid;gap:1.2rem;grid-template-columns:minmax(0,2fr) minmax(280px,1fr)}
.detail-card{background:var(--surface);border-radius:var(--radius);box-shadow:var(--shadow-lg);border:1px solid var(--border);padding:1.6rem}
.detail-card h2{margin-top:0}
.detail-section{margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid var(--border)}
.detail-section-title{font-size:.8rem;text-transform:uppercase;letter-spacing:.07em;color:var(--text-soft);font-weight:700;margin-bottom:1rem}
.detail-list{list-style:none}
.detail-list li{padding:.8rem 0;border-bottom:1px solid var(--border)}
.detail-list li:last-child{border-bottom:none}
.detail-label{display:block;color:var(--text-soft);margin-bottom:.3rem;font-size:.86rem}
.detail-value{color:var(--text);font-weight:600}
.piece-row{padding:1rem;border-radius:var(--radius-sm);background:var(--surface-soft);border:1px solid var(--border);margin-bottom:.75rem}
.piece-row:last-child{margin-bottom:0}
.piece-row-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:.6rem}
.piece-row-title{font-weight:700;font-size:.95rem}
.piece-row-note{font-size:.83rem;color:var(--text-muted);margin-top:.5rem}
.timeline{list-style:none;position:relative}
.timeline::before{content:'';position:absolute;left:9px;top:0;bottom:0;width:2px;background:var(--border)}
.timeline-item{padding:0 0 1.1rem 2rem;position:relative}
.timeline-item:last-child{padding-bottom:0}
.timeline-dot{position:absolute;left:3px;top:4px;width:14px;height:14px;border-radius:50%;background:var(--accent);border:2px solid var(--surface);box-shadow:0 0 0 2px var(--accent-soft)}
.timeline-dot.done{background:var(--success);box-shadow:0 0 0 2px var(--success-soft)}
.timeline-date{font-size:.8rem;color:var(--text-soft);margin-bottom:.15rem}
.timeline-title{font-weight:600;font-size:.93rem}
.timeline-note{font-size:.85rem;color:var(--text-muted)}
.activity-row{display:flex;align-items:flex-start;gap:.75rem;padding:.85rem 0;border-bottom:1px solid var(--border)}
.activity-row:last-child{border-bottom:none}
.activity-avatar{width:34px;height:34px;border-radius:50%;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center;font-weight:800;font-size:.85rem;flex-shrink:0}
.activity-name{font-weight:600;font-size:.92rem}
.activity-meta{font-size:.82rem;color:var(--text-soft);margin-top:.1rem}
.dashboard-top{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(320px,1fr);gap:1.5rem;margin-bottom:1.75rem}
.dashboard-intro{padding:2rem;border-radius:2rem;background:linear-gradient(160deg,#eef5ff,var(--surface-soft));border:1px solid rgba(37,99,235,.08)}
.eyebrow{display:inline-flex;margin-bottom:.85rem;padding:.4rem .85rem;border-radius:var(--radius-pill);background:#dbeafe;color:#1d4ed8;font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em}
.dashboard-metrics{display:grid;gap:.85rem;grid-template-columns:repeat(2,1fr)}
.metric-card{padding:1.1rem 1.2rem;border-radius:var(--radius);border:1px solid var(--border);background:var(--surface);box-shadow:var(--shadow)}
.metric-card h3{margin:0 0 .45rem;font-size:.78rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em}
.metric-value{font-size:2rem;font-weight:800;line-height:1}
.metric-desc{margin:.5rem 0 0;color:var(--text-soft);font-size:.82rem}
.metric-primary{background:linear-gradient(180deg,#eff6ff,#dbeafe)}
.metric-secondary{background:linear-gradient(180deg,#eef2ff,#e0e7ff)}
.metric-accent{background:linear-gradient(180deg,#ecfdf5,#d1fae5)}
.metric-info{background:linear-gradient(180deg,#f0f9ff,#bae6fd)}
.metric-warning{background:linear-gradient(180deg,var(--warning-soft),#fde68a)}
.metric-tertiary{background:linear-gradient(180deg,#f8fafc,#e2e8f0)}
.dashboard-grid{display:grid;gap:1.5rem;grid-template-columns:repeat(3,minmax(0,1fr))}
.dashboard-panel{padding:1.5rem;background:var(--surface);border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow-lg);display:flex;flex-direction:column;gap:1.1rem}
.panel-header{display:flex;align-items:flex-start;justify-content:space-between;gap:.75rem}
.panel-header h2{margin:0;font-size:1.05rem;font-weight:700}
.panel-subtitle{margin:.3rem 0 0;color:var(--text-soft);font-size:.85rem}
.panel-card{padding:1rem;border-radius:var(--radius-sm);background:var(--surface-soft);border:1px solid rgba(37,99,235,.1)}
.panel-label{margin:0 0 .5rem;font-size:.8rem;color:var(--text-soft)}
.panel-meta{margin:.35rem 0 0;color:var(--text-muted);font-size:.86rem}
.panel-note{margin:.6rem 0 0;color:var(--text);font-weight:600;font-size:.88rem}
.panel-actions{margin-top:.85rem}
.panel-empty{padding:1rem;color:var(--text-muted);background:#f8fafc;border-radius:var(--radius-sm);font-size:.88rem}
.streak-list{display:flex;flex-direction:column;gap:.85rem}
.streak-row{display:flex;align-items:center;justify-content:space-between;gap:.5rem}
.streak-name{font-weight:600;font-size:.93rem}
.streak-count{font-size:.83rem;color:var(--accent);font-weight:700}
.achievement-row{display:flex;align-items:flex-start;gap:.65rem;padding:.85rem;border-radius:var(--radius-sm);background:var(--gold-soft);border:1px solid #fde68a;margin-bottom:.65rem}
.achievement-row:last-child{margin-bottom:0}
.achievement-icon{font-size:1.2rem;line-height:1.2}
.achievement-title{font-weight:700;font-size:.88rem;color:var(--gold)}
.achievement-meta{font-size:.8rem;color:#92400e;margin-top:.1rem}
.dashboard-cta{display:flex;flex-direction:column;justify-content:space-between}
.dashboard-links{display:flex;flex-wrap:wrap;gap:.55rem;margin:.5rem 0 .75rem}
.nav-chip{display:inline-flex;align-items:center;gap:.3rem;padding:.65rem .9rem;border-radius:var(--radius-pill);border:1px solid rgba(37,99,235,.2);color:var(--accent);background:var(--accent-soft);font-weight:700;font-size:.85rem;transition:background var(--transition)}
.nav-chip:hover{background:rgba(37,99,235,.16)}
.panel-desc{color:var(--text-muted);font-size:.86rem}
.btn{display:inline-flex;align-items:center;justify-content:center;padding:.45rem 1.1rem;border-radius:.75rem;font-size:.88rem;font-weight:600;cursor:pointer;border:1px solid transparent;transition:background var(--transition),border-color var(--transition),transform var(--transition);white-space:nowrap}
.btn:hover{transform:translateY(-1px)}
.btn-sm{padding:.32rem .8rem;font-size:.8rem;border-radius:.6rem}
.btn-primary{background:var(--accent);color:#fff;border-color:var(--accent)}
.btn-primary:hover{background:var(--accent-mid);border-color:var(--accent-mid)}
.btn-outline-primary{background:transparent;color:var(--accent);border-color:rgba(37,99,235,.4)}
.btn-outline-primary:hover{background:var(--accent-soft)}
.mt-3{margin-top:1rem}.mt-4{margin-top:1.5rem}.pb-3{padding-bottom:1rem}
@@media (max-width:991px){
  .app-shell{grid-template-columns:1fr}
  .app-sidebar{position:fixed;left:-300px;top:0;height:100%;width:280px;z-index:150;transition:left .3s ease}
  .app-sidebar.open{left:0;box-shadow:4px 0 24px rgba(0,0,0,.3)}
  .hamburger{display:flex}
  .app-main{padding:4rem 1.25rem 1.5rem}
  .detail-panel{grid-template-columns:1fr}
  .dashboard-top,.dashboard-grid{grid-template-columns:1fr}
  .dashboard-metrics{grid-template-columns:repeat(2,1fr)}
}
@@media (max-width:640px){
  .dashboard-metrics{grid-template-columns:1fr}
  .entity-grid{grid-template-columns:1fr}
}
    </style>
</head>
<body>
    @{ var ctrl = ViewContext.RouteData.Values["controller"]?.ToString(); }

    <button class="hamburger" id="hamburger" aria-label="Open menu">☰</button>

    <div class="app-shell">
        <aside class="app-sidebar" id="sidebar">
            <a class="brand-panel" asp-area="" asp-controller="Home" asp-action="Index">
                <div class="brand-mark">♪</div>
                <div>
                    <div class="brand-title">Piano Tracker</div>
                    <div class="brand-subtitle">Learning dashboard</div>
                </div>
            </a>

            <div class="piano-separator" aria-hidden="true">
                <div class="piano-key w"></div><div class="piano-key b"></div>
                <div class="piano-key w"></div><div class="piano-key b"></div>
                <div class="piano-key w"></div><div class="piano-key w"></div>
                <div class="piano-key b"></div><div class="piano-key w"></div>
                <div class="piano-key b"></div><div class="piano-key w"></div>
                <div class="piano-key b"></div><div class="piano-key w"></div>
                <div class="piano-key w"></div>
            </div>

            <nav class="sidebar-nav">
                <a class="sidebar-link @(ctrl == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <span class="nav-icon">🎹</span> Dashboard
                </a>
                <a class="sidebar-link @(ctrl == "Student" ? "active" : "")" asp-controller="Student" asp-action="Index">
                    <span class="nav-icon">🎓</span> Students
                </a>
                <a class="sidebar-link @(ctrl == "Teacher" ? "active" : "")" asp-controller="Teacher" asp-action="Index">
                    <span class="nav-icon">🎵</span> Teachers
                </a>
                <a class="sidebar-link @(ctrl == "Piece" ? "active" : "")" asp-controller="Piece" asp-action="Index">
                    <span class="nav-icon">🎼</span> Pieces
                </a>
                <a class="sidebar-link @(ctrl == "Lesson" ? "active" : "")" asp-controller="Lesson" asp-action="Index">
                    <span class="nav-icon">📅</span> Lessons
                </a>
                <a class="sidebar-link @(ctrl == "PracticeSession" ? "active" : "")" asp-controller="PracticeSession" asp-action="Index">
                    <span class="nav-icon">⏱</span> Practice Sessions
                </a>
                <a class="sidebar-link @(ctrl == "Ai" ? "active" : "")" asp-controller="Ai" asp-action="Index">
                    <span class="nav-icon">🤖</span> AI Assistant
                </a>
            </nav>

            <div class="sidebar-note">Piano Learning Tracker · Read-only mock data</div>
        </aside>

        <div class="app-main">
            <header class="page-header">
                <h1>@ViewData["Title"]</h1>
            </header>

            <main role="main" class="pb-3">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>&copy; 2026 Piano Learning Tracker</span>
                <span>Mock repository · Read-only views</span>
            </footer>
        </div>
    </div>

    <script>
        const hamburger = document.getElementById('hamburger');
        const sidebar = document.getElementById('sidebar');
        hamburger?.addEventListener('click', e => { e.stopPropagation(); sidebar.classList.toggle('open'); });
        document.addEventListener('click', e => { if (sidebar.classList.contains('open') && !sidebar.contains(e.target)) sidebar.classList.remove('open'); });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
