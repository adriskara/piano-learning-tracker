<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PianoLearningTracker</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PianoLearningTracker.styles.css" asp-append-version="true" />
</head>
<body>
    @{ var currentController = ViewContext.RouteData.Values["controller"]?.ToString(); }
    <div class="app-shell">
        <aside class="app-sidebar">
            <a class="brand-panel" asp-area="" asp-controller="Home" asp-action="Index">
                <div class="brand-mark">♪</div>
                <div>
                    <div class="brand-title">Piano Tracker</div>
                    <div class="brand-subtitle">Mock data UX</div>
                </div>
            </a>

            <nav class="sidebar-nav">
                <a class="sidebar-link @(currentController == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Dashboard</a>
                <a class="sidebar-link @(currentController == "Student" ? "active" : "")" asp-area="" asp-controller="Student" asp-action="Index">Students</a>
                <a class="sidebar-link @(currentController == "Teacher" ? "active" : "")" asp-area="" asp-controller="Teacher" asp-action="Index">Teachers</a>
                <a class="sidebar-link @(currentController == "Piece" ? "active" : "")" asp-area="" asp-controller="Piece" asp-action="Index">Pieces</a>
                <a class="sidebar-link @(currentController == "Lesson" ? "active" : "")" asp-area="" asp-controller="Lesson" asp-action="Index">Lessons</a>
                <a class="sidebar-link @(currentController == "PracticeSession" ? "active" : "")" asp-area="" asp-controller="PracticeSession" asp-action="Index">Practice Sessions</a>
                <a class="sidebar-link @(currentController == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Privacy" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </nav>

            <div class="sidebar-note">Unique layout with static mock repository data.</div>
        </aside>

        <div class="app-main">
            <header class="page-header">
                <div>
                    <h1>@ViewData["Title"]</h1>
                    <p class="page-subtitle">A custom interface built on the Piano Learning Tracker mock data model.</p>
                </div>
            </header>

            <main role="main" class="pb-3">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>&copy; 2026 Piano Learning Tracker</span>
                <span class="app-footer-text">Mock repository, read-only views, and a custom UX.</span>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
