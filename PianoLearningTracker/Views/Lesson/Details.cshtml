@model PianoLearningTracker.Models.Lesson

@{
    ViewData["Title"] = "Lesson details";
}

<ul class="breadcrumb-list">
    <li><a asp-controller="Lesson" asp-action="Index">Lessons</a></li>
    <li>Lesson #@Model.Id</li>
</ul>

<div class="detail-panel">
    <section class="detail-card">
        <h2>Lesson #@Model.Id</h2>
        <p class="detail-label">Scheduled</p>
        <p class="detail-value">@Model.ScheduledDate:dddd, MMM d yyyy HH:mm</p>
        <p class="detail-label">Duration</p>
        <p class="detail-value">@Model.DurationMinutes minutes</p>
        <p class="detail-label">Status</p>
        <p class="detail-value">@Model.Status</p>
        <p class="detail-label">Homework</p>
        <p class="detail-value">@Model.HomeworkAssigned</p>
        <p class="detail-label">Notes</p>
        <p class="detail-value">@Model.Notes</p>
    </section>

    <section class="detail-card">
        <h2>Participants</h2>
        <ul class="detail-list">
            <li>
                <span class="detail-label">Student</span>
                <span class="detail-value">@Model.Student.FirstName @Model.Student.LastName</span>
            </li>
            <li>
                <span class="detail-label">Teacher</span>
                <span class="detail-value">@Model.Teacher.FirstName @Model.Teacher.LastName</span>
            </li>
        </ul>

        <h3 class="mt-4">Pieces in this lesson</h3>
        @if (Model.LessonPieces.Any())
        {
            <ul class="detail-list">
                @foreach (var lessonPiece in Model.LessonPieces)
                {
                    <li>
                        <strong>@lessonPiece.Piece.Title</strong>
                        <div class="detail-label">@lessonPiece.Notes</div>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="detail-value">No pieces are linked to this lesson yet.</p>
        }
    </section>
</div>
