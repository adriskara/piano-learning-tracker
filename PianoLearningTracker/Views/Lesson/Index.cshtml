@model IEnumerable<PianoLearningTracker.Models.Lesson>

@{
    ViewData["Title"] = "Satovi";
}

<ul class="breadcrumb-list">
    <li><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
    <li>Satovi</li>
</ul>

<div class="page-toolbar">
    <div class="search-bar">
        <span class="search-icon">🔍</span>
        <input type="text" id="search-input" class="search-input" placeholder="Pretraži satove..." autocomplete="off" />
    </div>
    @if (User.IsInRole("Administrator") || User.IsInRole("Teacher"))
    {
        <a class="btn btn-primary" asp-action="Create">+ Novi sat</a>
    }
</div>

<div id="lessons-container">
    @await Html.PartialAsync("_LessonList", Model)
</div>

@section Scripts {
    <script>
        // AJAX pretraga satova
        var searchTimer;
        document.getElementById('search-input').addEventListener('input', function () {
            clearTimeout(searchTimer);
            var q = this.value;
            searchTimer = setTimeout(function () {
                fetch('/satovi/pretraga?q=' + encodeURIComponent(q), {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    document.getElementById('lessons-container').innerHTML = html;
                    animateCards();
                });
            }, 300);
        });

        animateCards();
    </script>
}
