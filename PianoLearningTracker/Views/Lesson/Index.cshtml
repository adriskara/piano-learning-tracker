@model IEnumerable<PianoLearningTracker.Models.Lesson>

@{
    ViewData["Title"] = "Lessons";
}

<ul class="breadcrumb-list">
    <li>Dashboard</li>
    <li>Lessons</li>
</ul>

<div class="entity-grid">
    @foreach (var lesson in Model)
    {
        <article class="entity-card">
            <h2 class="entity-card-title">Lesson #@lesson.Id</h2>
            <p class="entity-card-meta">@lesson.ScheduledDate:dddd, MMM d yyyy HH:mm</p>
            <p class="entity-card-meta">Student: @lesson.Student.FirstName @lesson.Student.LastName</p>
            <span class="badge bg-info text-dark badge-pill">@lesson.Status</span>
            <div class="entity-card-actions mt-3">
                <a class="btn btn-primary btn-sm" asp-action="Details" asp-route-id="@lesson.Id">View details</a>
            </div>
        </article>
    }
</div>
