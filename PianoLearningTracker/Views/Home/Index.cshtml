@model PianoLearningTracker.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Dashboard";
    var isAdmin = Model.UserRole == "Administrator";
    var isTeacher = Model.UserRole == "Teacher";
    var isStudent = Model.UserRole == "Student";
}

<section class="dashboard-top">
    <div class="dashboard-intro">
        <span class="eyebrow">
            @if (isAdmin) { <text>🔧 Administrator</text> }
            else if (isTeacher) { <text>🎵 Profesor</text> }
            else { <text>🎓 Učenik</text> }
        </span>
        <h2 style="margin:0 0 0.5rem; font-size:1.6rem; font-weight:800; letter-spacing:-0.03em;">
            @if (isAdmin) { <text>Pregled sustava</text> }
            else if (isTeacher) { <text>Moji učenici i satovi</text> }
            else { <text>Moji satovi i vježbe</text> }
        </h2>
        <p style="color:var(--text-muted); margin:0;">
            @if (isAdmin) { <text>Ukupni pregled svih podataka u sustavu.</text> }
            else if (isTeacher) { <text>Prikazuju se samo vaši učenici i satovi.</text> }
            else { <text>Prikazuju se samo vaši osobni podaci.</text> }
        </p>
    </div>

    <div class="dashboard-metrics">
        @if (isAdmin || isTeacher)
        {
            <article class="metric-card metric-primary">
                <h3>Učenici</h3>
                <p class="metric-value">@Model.StudentCount</p>
                <p class="metric-desc">@(isTeacher ? "Moji učenici" : "Aktivnih")</p>
            </article>
        }
        @if (isAdmin)
        {
            <article class="metric-card metric-secondary">
                <h3>Profesori</h3>
                <p class="metric-value">@Model.TeacherCount</p>
                <p class="metric-desc">Nastavnog osoblja</p>
            </article>
        }
        <article class="metric-card metric-accent">
            <h3>Skladbe</h3>
            <p class="metric-value">@Model.PieceCount</p>
            <p class="metric-desc">@(isStudent ? "U repertoaru" : "Dostupnih")</p>
        </article>
        <article class="metric-card metric-info">
            <h3>Satovi</h3>
            <p class="metric-value">@Model.LessonCount</p>
            <p class="metric-desc">@(isStudent || isTeacher ? "Mojih sati" : "Ukupno")</p>
        </article>
        <article class="metric-card metric-warning">
            <h3>Vježbe</h3>
            <p class="metric-value">@Model.PracticeSessionCount</p>
            <p class="metric-desc">@(isStudent ? "Mojih sesija" : "Evidentirano")</p>
        </article>
        <article class="metric-card metric-tertiary">
            <h3>Nadolazeći</h3>
            <p class="metric-value">@Model.ScheduledLessonCount</p>
            <p class="metric-desc">Zakazanih sati</p>
        </article>
        @if (Model.CompletedPieceCount > 0 || isStudent)
        {
            <article class="metric-card metric-green">
                <h3>Završeno</h3>
                <p class="metric-value">@Model.CompletedPieceCount</p>
                <p class="metric-desc">Skladbi savladano</p>
            </article>
        }
    </div>
</section>

<section class="dashboard-grid">

    <!-- Sljedeći sat -->
    <article class="dashboard-panel">
        <div class="panel-header">
            <div>
                <h2>📅 Sljedeći sat</h2>
                <p class="panel-subtitle">Nadolazeći zakazani termin</p>
            </div>
            <a class="btn btn-sm btn-outline-primary" asp-controller="Lesson" asp-action="Index">Svi satovi</a>
        </div>
        @if (Model.NextLesson is not null)
        {
            <div class="panel-card">
                <p class="panel-label">Sat #@Model.NextLesson.Id · @Model.NextLesson.ScheduledDate.ToString("dddd, d. MMM")</p>
                <strong style="font-size:1rem;">@Model.NextLesson.Student.FirstName @Model.NextLesson.Student.LastName</strong>
                @if (!isStudent)
                {
                    <p class="panel-meta">Profesor: @Model.NextLesson.Teacher.FirstName @Model.NextLesson.Teacher.LastName</p>
                }
                <p class="panel-meta">Trajanje: @Model.NextLesson.DurationMinutes min</p>
                @if (!string.IsNullOrEmpty(Model.NextLesson.HomeworkAssigned))
                {
                    <p class="panel-note">🏠 @Model.NextLesson.HomeworkAssigned</p>
                }
                <div class="panel-actions">
                    <a class="btn btn-primary btn-sm" asp-controller="Lesson" asp-action="Details" asp-route-id="@Model.NextLesson.Id">Otvori detalje</a>
                </div>
            </div>
        }
        else
        {
            <div class="panel-empty">Nema zakazanih sati.</div>
        }
    </article>

    <!-- Vježbanje: streaks (Admin/Teacher) ili najnovija vježba (Student) -->
    @if (!isStudent && Model.PracticeStreaks.Any())
    {
        <article class="dashboard-panel">
            <div class="panel-header">
                <div>
                    <h2>🔥 Vježbanje učenika</h2>
                    <p class="panel-subtitle">Sesije po učeniku</p>
                </div>
                <a class="btn btn-sm btn-outline-primary" asp-controller="PracticeSession" asp-action="Index">Sve vježbe</a>
            </div>
            <div class="streak-list">
                @foreach (var streak in Model.PracticeStreaks)
                {
                    <div>
                        <div class="streak-row">
                            <span class="streak-name">@streak.StudentName</span>
                            <span class="streak-count">@streak.SessionCount sesija</span>
                        </div>
                        <div class="progress-track" style="margin-top:0.4rem;">
                            @{
                                var maxSessions = Model.PracticeStreaks.Max(s => s.SessionCount);
                                var pct = maxSessions > 0 ? streak.SessionCount * 100 / maxSessions : 0;
                            }
                            <div class="progress-fill" style="width:@pct%;"></div>
                        </div>
                        <p style="font-size:0.78rem;color:var(--text-soft);margin:0.25rem 0 0;">@streak.TotalMinutes min ukupno</p>
                    </div>
                }
            </div>
        </article>
    }

    @if (isStudent)
    {
        <!-- Student: najnovija vježba -->
        <article class="dashboard-panel">
            <div class="panel-header">
                <div>
                    <h2>⏱ Zadnja vježba</h2>
                    <p class="panel-subtitle">Moja najnovija sesija</p>
                </div>
                <a class="btn btn-sm btn-outline-primary" asp-controller="PracticeSession" asp-action="Index">Sve moje vježbe</a>
            </div>
            @if (Model.LatestPracticeSession is not null)
            {
                <div class="panel-card">
                    <p class="panel-label">@Model.LatestPracticeSession.Date.ToString("d. MMM yyyy")</p>
                    <p class="panel-meta">🎼 @Model.LatestPracticeSession.Piece.Title</p>
                    <p class="panel-meta">@Model.LatestPracticeSession.DurationMinutes min ·
                        @for (var i = 1; i <= 5; i++) { <span>@(i <= Model.LatestPracticeSession.QualityRating ? "★" : "☆")</span> }
                    </p>
                    <p class="panel-note">@Model.LatestPracticeSession.Goals</p>
                </div>
            }
            else
            {
                <div class="panel-empty">Nema evidentiranih vježbi.</div>
            }
        </article>
    }

    <!-- Dostignuća -->
    <article class="dashboard-panel">
        <div class="panel-header">
            <div>
                <h2>🏆 Dostignuća</h2>
                <p class="panel-subtitle">Završene skladbe</p>
            </div>
        </div>
        @if (Model.RecentAchievements.Any())
        {
            @foreach (var a in Model.RecentAchievements)
            {
                <div class="achievement-row">
                    <span class="achievement-icon">🎖</span>
                    <div>
                        <div class="achievement-title">@a.Piece.Title</div>
                        <div class="achievement-meta">
                            @if (!isStudent) { <text>@a.Student.FirstName @a.Student.LastName · </text> }
                            @if (a.CompletionDate.HasValue) { <span>Završeno @a.CompletionDate.Value.ToString("MMM yyyy")</span> }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="panel-empty">Još nema završenih skladbi.</div>
        }
    </article>

    @if (!isStudent)
    {
        <!-- Admin/Teacher: najnovija vježba -->
        <article class="dashboard-panel">
            <div class="panel-header">
                <div>
                    <h2>⏱ Zadnja vježba</h2>
                    <p class="panel-subtitle">Najnovija evidentirana sesija</p>
                </div>
            </div>
            @if (Model.LatestPracticeSession is not null)
            {
                <div class="panel-card">
                    <p class="panel-label">@Model.LatestPracticeSession.Date.ToString("d. MMM yyyy")</p>
                    <strong>@Model.LatestPracticeSession.Student.FirstName @Model.LatestPracticeSession.Student.LastName</strong>
                    <p class="panel-meta">🎼 @Model.LatestPracticeSession.Piece.Title</p>
                    <p class="panel-meta">@Model.LatestPracticeSession.DurationMinutes min ·
                        @for (var i = 1; i <= 5; i++) { <span>@(i <= Model.LatestPracticeSession.QualityRating ? "★" : "☆")</span> }
                    </p>
                </div>
            }
            else
            {
                <div class="panel-empty">Nema evidentiranih vježbi.</div>
            }
        </article>
    }

    <!-- Navigacija po sekcijama -->
    <article class="dashboard-panel dashboard-cta" style="grid-column: span 2;">
        <div class="panel-header">
            <h2>🗺 Navigacija</h2>
        </div>
        <div class="dashboard-links">
            @if (isAdmin || isTeacher)
            {
                <a class="nav-chip" asp-controller="Student" asp-action="Index">🎓 Učenici</a>
            }
            @if (isAdmin)
            {
                <a class="nav-chip" asp-controller="Teacher" asp-action="Index">🎵 Profesori</a>
            }
            <a class="nav-chip" asp-controller="Piece" asp-action="Index">🎼 Skladbe</a>
            <a class="nav-chip" asp-controller="Lesson" asp-action="Index">📅 Satovi</a>
            <a class="nav-chip" asp-controller="PracticeSession" asp-action="Index">⏱ Vježbanje</a>
            <a class="nav-chip" asp-controller="Ai" asp-action="Index">🤖 AI Asistent</a>
        </div>
    </article>

</section>
