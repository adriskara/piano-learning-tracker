@model PianoLearningTracker.Models.ExternalLoginConfirmationViewModel
@{
    ViewData["Title"] = "Dovršite registraciju";
}

<div class="auth-card">
    <div class="auth-icon">🔑</div>
    <h2 class="auth-title">Dovršite registraciju</h2>
    <p class="text-muted text-center mb-3">
        Prijavili ste se putem Google računa. Unesite OIB kako biste dovršili registraciju.
    </p>

    <form asp-action="ExternalLoginConfirmation" method="post">
        <div asp-validation-summary="ModelOnly" class="auth-error"></div>

        <div class="form-group">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" class="form-control" readonly />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="OIB">OIB</label>
            <input asp-for="OIB" class="form-control" placeholder="11-znamenkasti OIB" maxlength="11" />
            <span asp-validation-for="OIB" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-primary auth-submit">Završi registraciju</button>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
