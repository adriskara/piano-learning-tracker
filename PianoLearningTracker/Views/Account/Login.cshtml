@model PianoLearningTracker.Models.LoginViewModel
@{
    ViewData["Title"] = "Prijava";
}

<div class="auth-card">
    <div class="auth-icon">🔑</div>
    <h2 class="auth-title">Prijava</h2>

    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
        <div asp-validation-summary="ModelOnly" class="auth-error"></div>

        <div class="form-group">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" class="form-control" placeholder="vas@email.com" autocomplete="username" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password">Lozinka</label>
            <input asp-for="Password" class="form-control" placeholder="••••••" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="form-check">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Zapamti me</label>
        </div>

        <button type="submit" class="btn btn-primary auth-submit">Prijavi se</button>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
