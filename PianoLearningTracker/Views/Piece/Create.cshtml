@model PianoLearningTracker.Models.PieceFormModel

@{
    ViewData["Title"] = "Nova skladba";
}

<ul class="breadcrumb-list">
    <li><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
    <li><a asp-controller="Piece" asp-action="Index">Skladbe</a></li>
    <li>Nova skladba</li>
</ul>

<div class="form-card">
    <form asp-action="Create" method="post" novalidate>
        @Html.AntiForgeryToken()

        <div class="form-grid-2">
            <div class="form-group">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" placeholder="npr. Für Elise" />
                <span asp-validation-for="Title" class="text-danger field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Composer" class="form-label"></label>
                <input asp-for="Composer" class="form-control" placeholder="npr. Ludwig van Beethoven" />
                <span asp-validation-for="Composer" class="text-danger field-error"></span>
            </div>
        </div>

        <div class="form-grid-2">
            <div class="form-group">
                <label asp-for="Difficulty" class="form-label"></label>
                <select asp-for="Difficulty" class="form-control"
                        asp-items="Html.GetEnumSelectList<PianoLearningTracker.Models.DifficultyLevel>()">
                    <option value="">-- Odaberi težinu --</option>
                </select>
                <span asp-validation-for="Difficulty" class="text-danger field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Genre" class="form-label"></label>
                <input asp-for="Genre" class="form-control" placeholder="npr. Klasika, Romantizam, Barok..." />
                <span asp-validation-for="Genre" class="text-danger field-error"></span>
            </div>
        </div>

        <div class="form-grid-2">
            <div class="form-group">
                <label asp-for="DurationMinutes" class="form-label"></label>
                <input asp-for="DurationMinutes" class="form-control" type="number" min="1" max="120" />
                <span asp-validation-for="DurationMinutes" class="text-danger field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="YearComposed" class="form-label"></label>
                <input asp-for="YearComposed" class="form-control" type="number" min="1000" max="2100" />
                <span asp-validation-for="YearComposed" class="text-danger field-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Kratki opis skladbe..."></textarea>
            <span asp-validation-for="Description" class="text-danger field-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Spremi skladbu</button>
            <a asp-action="Index" class="btn btn-secondary">Odustani</a>
        </div>
    </form>
</div>
