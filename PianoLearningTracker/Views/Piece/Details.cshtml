@model PianoLearningTracker.Models.Piece

@{
    ViewData["Title"] = Model.Title;
}

<ul class="breadcrumb-list">
    <li><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
    <li><a asp-controller="Piece" asp-action="Index">Skladbe</a></li>
    <li>@Model.Title</li>
</ul>

@if (User.IsInRole("Administrator"))
{
    <div class="page-actions">
        <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.Id">✏️ Uredi</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="inline-form"
              onsubmit="return confirm('Jeste li sigurni da želite obrisati skladbu @Model.Title?')">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">🗑 Obriši</button>
        </form>
    </div>
}

<div class="detail-panel">

    <div>
        <section class="detail-card">
            <h2 style="margin-bottom:0.25rem;">@Model.Title</h2>
            <p style="color:var(--text-soft);margin:0 0 1.25rem;">
                🎼 @Model.Composer · @Model.Difficulty
            </p>

            <ul class="detail-list">
                <li><span class="detail-label">Žanr</span><span class="detail-value">@Model.Genre</span></li>
                <li><span class="detail-label">Trajanje</span><span class="detail-value">@Model.DurationMinutes min</span></li>
                <li><span class="detail-label">Godina</span><span class="detail-value">@Model.YearComposed</span></li>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <li><span class="detail-label">Opis</span><span class="detail-value">@Model.Description</span></li>
                }
            </ul>

            @if (Model.PracticeSessions.Any())
            {
                <div class="detail-section">
                    <p class="detail-section-title">📅 Sesije vježbanja</p>
                    <ul class="timeline">
                        @foreach (var session in Model.PracticeSessions.OrderByDescending(s => s.Date).Take(5))
                        {
                            <li class="timeline-item">
                                <div class="timeline-dot @(session.QualityRating >= 4 ? "done" : "")"></div>
                                <div class="timeline-date">@session.Date.ToString("MMM d, yyyy")</div>
                                <div class="timeline-title">
                                    @session.Student.FirstName @session.Student.LastName
                                    <span style="font-weight:400;color:var(--text-soft);"> — @session.DurationMinutes min</span>
                                </div>
                                <a style="font-size:0.82rem;color:var(--accent);"
                                   asp-controller="PracticeSession" asp-action="Details" asp-route-id="@session.Id">Pogledaj →</a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </section>
    </div>

    <div style="display:flex;flex-direction:column;gap:1.2rem;">

        <section class="detail-card">
            <h2>📊 Statistika</h2>
            <ul class="detail-list">
                <li><span class="detail-label">Ukupno sesija</span><span class="detail-value">@Model.PracticeSessions.Count</span></li>
                <li><span class="detail-label">Ukupno minuta</span><span class="detail-value">@Model.PracticeSessions.Sum(s => s.DurationMinutes)</span></li>
                @if (Model.PracticeSessions.Any())
                {
                    <li>
                        <span class="detail-label">Prosječna ocjena</span>
                        <span class="detail-value">@Model.PracticeSessions.Average(s => s.QualityRating).ToString("F1") / 5</span>
                    </li>
                }
            </ul>
        </section>

        @if (Model.StudentPieces.Any())
        {
            <section class="detail-card">
                <h2>🎓 Učenici koji uče skladbu</h2>
                @foreach (var sp in Model.StudentPieces)
                {
                    <div class="activity-row">
                        <div class="activity-avatar">
                            @sp.Student.FirstName[0]@sp.Student.LastName[0]
                        </div>
                        <div>
                            <div class="activity-name">
                                <a asp-controller="Student" asp-action="Details" asp-route-id="@sp.Student.Id">
                                    @sp.Student.FirstName @sp.Student.LastName
                                </a>
                            </div>
                            <div class="activity-meta">
                                Napredak: @sp.ProgressRating/10 ·
                                @(sp.IsCompleted ? "Završeno" : "U tijeku")
                            </div>
                        </div>
                    </div>
                }
            </section>
        }

        <section class="detail-card" id="attachments-card">
            <h2>📎 Datoteke</h2>

            @if (User.IsInRole("Administrator"))
            {
                <div id="piece-dropzone" class="dropzone-area"
                     data-upload-url="/skladbe/upload/@Model.Id">
                    <div class="dropzone-message">
                        <span style="font-size:2rem;">📂</span>
                        <p style="margin:0.4rem 0 0;">Povuci datoteku ovdje ili <strong>klikni za odabir</strong></p>
                    </div>
                </div>
            }

            <div id="attachment-list-container" style="margin-top:1rem;">
                <p class="text-muted" style="font-size:0.875rem;">Učitavanje...</p>
            </div>
        </section>

    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/dropzone@5.9.3/dist/min/dropzone.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/dropzone@5.9.3/dist/min/dropzone.min.js"></script>
    <style>
        .dropzone-area {
            border: 2px dashed var(--border, #d1d5db);
            border-radius: 10px;
            padding: 1.5rem;
            text-align: center;
            cursor: pointer;
            transition: border-color 0.2s, background 0.2s;
            background: var(--surface-alt, #f9fafb);
        }
        .dropzone-area.dz-drag-hover, .dropzone-area:hover {
            border-color: var(--accent, #6366f1);
            background: var(--accent-soft, #eef2ff);
        }
        .dropzone-area .dz-message { display: none; }
        .dropzone-area .dz-preview { display: none; }
        #attachment-list-container table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
        #attachment-list-container th { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid var(--border, #e5e7eb); color: var(--text-soft, #6b7280); font-weight: 600; }
        #attachment-list-container td { padding: 0.5rem 0.6rem; border-bottom: 1px solid var(--border, #f3f4f6); vertical-align: middle; }
        #attachment-list-container a { color: var(--accent, #6366f1); text-decoration: none; }
        #attachment-list-container a:hover { text-decoration: underline; }
    </style>
    <script>
        var pieceId = @Model.Id;
        var antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

        function loadAttachments() {
            fetch('/skladbe/datoteke/' + pieceId)
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    document.getElementById('attachment-list-container').innerHTML = html;
                });
        }

        function deleteAttachment(id) {
            if (!confirm('Obrisati datoteku?')) return;
            fetch('/skladbe/obrisi-datoteku/' + id, {
                method: 'POST',
                headers: { 'RequestVerificationToken': antiForgeryToken }
            }).then(function (r) {
                if (r.ok) loadAttachments();
            });
        }

        var dzEl = document.getElementById('piece-dropzone');
        if (dzEl) {
            Dropzone.autoDiscover = false;
            var dz = new Dropzone('#piece-dropzone', {
                url: dzEl.dataset.uploadUrl,
                paramName: 'file',
                maxFilesize: 20,
                headers: { 'RequestVerificationToken': antiForgeryToken },
                dictDefaultMessage: '',
                success: function () { loadAttachments(); this.removeAllFiles(); },
                error: function (file, msg) { alert('Greška pri uploadu: ' + (msg.error || msg)); this.removeFile(file); }
            });
        }

        loadAttachments();
    </script>
}

