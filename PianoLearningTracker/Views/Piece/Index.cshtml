@model IEnumerable<PianoLearningTracker.Models.Piece>

@{
    ViewData["Title"] = "Pieces";
}

<ul class="breadcrumb-list">
    <li>Dashboard</li>
    <li>Pieces</li>
</ul>

<div class="entity-grid">
    @foreach (var piece in Model)
    {
        <article class="entity-card">
            <h2 class="entity-card-title">@piece.Title</h2>
            <p class="entity-card-meta">Composer: @piece.Composer</p>
            <p class="entity-card-meta">Difficulty: @piece.Difficulty • Genre: @piece.Genre</p>
            <div class="entity-card-actions">
                <a class="btn btn-primary btn-sm" asp-action="Details" asp-route-id="@piece.Id">View details</a>
            </div>
        </article>
    }
</div>
