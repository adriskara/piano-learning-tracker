{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -ExecutionPolicy Bypass -Command \"$content = [Console]::In.ReadToEnd(); Add-Content -Path '.github/hooks/agent_log.txt' -Value $content\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -ExecutionPolicy Bypass -Command \"$content = [Console]::In.ReadToEnd(); Add-Content -Path '.github/hooks/agent_log.txt' -Value $content\""
          }
        ]
      }
    ]
  }
}
